PORT=3000
WEB_ORIGIN=http://localhost:4200
DATABASE_URL=postgres://visualizer:visualizer@postgres:5432/visualizer
# Replace with a private 32-byte secret before storing credentials.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-byte-secret-key-123456

# Supported providers: deepseek, openai, custom.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# For AI_PROVIDER=custom, set a provider base URL (for example, https://host/v1)
# or a full OpenAI-compatible /chat/completions URL, plus AI_MODEL.
AI_CHAT_COMPLETIONS_URL=
# Optional for custom endpoints; sent as a Bearer token when provided.
AI_API_KEY=
